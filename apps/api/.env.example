# 复制为 .env 后按需修改。示例只放占位值，不要提交真实密钥。
APP_ENV=development
APP_VERSION=0.2.0
PUBLIC_BASE_URL=http://localhost:5177

# PostgreSQL 17 + PostGIS 3。请填真实密码，不要把本文件提交到版本库。
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/travel_planner
STORAGE_ROOT=./data

# 会话密钥：生产必须替换为随机 32 字节以上字符串
SESSION_SECRET=CHANGE_ME_32_BYTES_RANDOM
SESSION_TTL_DAYS=14
SESSION_IDLE_DAYS=7
COOKIE_SECURE=false

REGISTRATION_MODE=open
INVITE_CODES=

# 地图数据源；留空时对应能力返回 PROVIDER_NOT_CONFIGURED。
# 推荐在登录后的「设置 → 地图数据源」维护（加密入库、只回掩码）；这里只用于首次启动的环境变量默认值。
# 变量名必须与 app/config.py 的字段一致：AMAP_KEY / TIANDITU_KEY / TIANDITU_BROWSER_KEY。
AMAP_KEY=
TIANDITU_KEY=
# 天地图浏览器瓦片 Key，会出现在前端瓦片地址中，需在控制台配置域名白名单
TIANDITU_BROWSER_KEY=
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_QPS=1

# 邮箱验证码（未配置 SMTP 时只写后端日志，接口返回 dev=true；生产必须配置）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 无路网数据时的显式估算参数（结果会标注为估算）
ESTIMATE_DRIVING_KMH=28
ESTIMATE_WALKING_KMH=4.5
ESTIMATE_DETOUR_FACTOR=1.35
