{
  "name": "travel-planner-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "codegen:api": "pnpm dlx --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.107.1",
    "antd": "6.7.0",
    "dayjs": "1.11.23",
    "maplibre-gl": "5.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
